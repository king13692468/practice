class Solution {
    public int romanToInt(String s) {
        int total = 0;
        
        // Loop through each character in the string
        for (int i = 0; i < s.length(); i++) {
            int currentVal = getValue(s.charAt(i));
            
            // Check if there is a next character and if it's bigger than the current one.
            // If the current symbol is smaller than the next (like I before V), we subtract it.
            if (i + 1 < s.length() && currentVal < getValue(s.charAt(i + 1))) {
                total -= currentVal;
            } else {
                // Otherwise, we just add it like normal
                total += currentVal;
            }
        }
        
        return total;
    }

    // A quick helper method to convert the letter to its number
    private int getValue(char c) {
        switch (c) {
            case 'I': return 1;
            case 'V': return 5;
            case 'X': return 10;
            case 'L': return 50;
            case 'C': return 100;
            case 'D': return 500;
            case 'M': return 1000;
            default: return 0;
        }
    }
}
